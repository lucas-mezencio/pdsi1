DATABASE_URL=postgres://mednotify:mednotify@postgres:5432/mednotify?sslmode=disable
TEST_DATABASE_URL=postgres://mednotify:mednotify@postgres:5432/mednotify?sslmode=disable
HTTP_ADDR=:8080
REDIS_ADDR=redis:6379

# Master key for symmetric column-level encryption via pgcrypto (LGPD).
# Must be set before running migrations or starting the API; the process exits
# otherwise. Generate a value with `openssl rand -base64 32` (>= 32 bytes
# recommended). The same value must be used by every replica of the API and by
# any backup-restore or read-replica workflow.
# DB_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# notifier mode: dev uses dummy sender, ready uses firebase
NOTIFIER_MODE=dev

# firebase service account json path
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# firebase web API key (used for email/password login via Identity Toolkit)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# demo secret for POST /prescriptions (overrides Firebase JWT auth for this endpoint)
DEMO_PRESCRIPTION_SECRET=your_demo_secret_here

# log format: text (default, human-readable stdout) or json (machine-readable)
# For local development the default "text" is easier to read; set to "json" in
# production where logs are shipped to a structured log aggregator.
# LOG_FORMAT=text

# log level: debug, info (default), warn, error
# debug emits the per-field debug statements inside handlers/services in addition
# to the request-completed log line emitted by the logging middleware.
LOG_LEVEL=info
