# Environment for cmd/testnotify. Copy to .env and fill in real values.
# testnotify picks up this file via config.Load("cmd/testnotify/.env")
# when invoked from the project root.

# Database connection — must point at the same Postgres the API uses.
# The default assumes you run testnotify from the host against a Postgres
# published on localhost (e.g. the docker-compose dev stack).
DATABASE_URL=postgres://mednotify:mednotify@localhost:5432/mednotify?sslmode=disable

# Redis (used only for the migration step on startup, not for notification
# dispatch). Same value as the API.
REDIS_ADDR=localhost:6379

# Firebase Admin SDK service account JSON. Required — NewFirebaseSender
# fail-fasts if this is empty or the file does not exist.
FIREBASE_CREDENTIALS_FILE=/absolute/path/to/firebase-service-account.json